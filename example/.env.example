# ── REQUIRED ──────────────────────────────────────────────────────────
# Your webchat channel id. This is the public token from the channel's
# embed snippet — it's safe to ship in the app binary (the visitor API
# is public by design; it's how the web Bubble works).
#
# Where to find it:
#   Janis console → your agent → Channels → open your "Bubble" channel
#   → Install tab → the embed snippet looks like:
#
#     <script src="https://app.janis.ai/widget.js"
#             data-janis-token="ch_xxxxxxxxxxxx" async></script>
#                              ^^^^^^^^^^^^^^^^  ← this value
#
# (The channel id also appears in the channel's edit URL/detail view.)
EXPO_PUBLIC_JANIS_CHANNEL_TOKEN=

# API origin. Defaults to https://app.janis.ai (prod — sends/replies are
# REAL). For a local janis-api:
#   iOS simulator:     http://localhost:8787
#   Android emulator:  http://10.0.2.2:8787
#   physical device:   http://<your-LAN-IP>:8787
# EXPO_PUBLIC_JANIS_BASE_URL=http://localhost:8787
